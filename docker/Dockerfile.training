# ── Training Container Dockerfile ──────────────────────────────────────────────
# CUDA-capable container for fine-tuning SLM models via LoRA.
# Base image matches PyTorch runtime with CUDA 12.1 support.

FROM pytorch/pytorch:2.2.1-cuda12.1-cudnn8-runtime

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive \
    HUGGINGFACE_HUB_CACHE=/root/.cache/huggingface

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Install common ML training requirements
# Pre-install key heavy packages to cache layers
RUN pip install --no-cache-dir \
    transformers==4.38.1 \
    peft==0.8.2 \
    accelerate==0.27.2 \
    datasets==2.17.1 \
    tinker>=0.8.1 \
    mlflow>=2.10.0 \
    loguru>=0.7.0 \
    pyyaml>=6.0

# Copy project manifest and source
COPY pyproject.toml /workspace/
COPY src/ /workspace/src/
COPY configs/ /workspace/configs/

# Install the local package in editable or standard mode
RUN pip install --no-cache-dir -e .

# Default container entrypoint starts training run orchestrator
ENTRYPOINT ["python", "-m", "email_data_engineering.pipeline"]
