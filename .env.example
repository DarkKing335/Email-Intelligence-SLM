# ── Environment Configuration for Email Data Engineering ──────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Data Directories ──────────────────────────────────────────────────────────
# Absolute or project-relative paths to raw and processed data.
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_REPORTS_DIR=reports
DATA_SAMPLES_DIR=data/samples
DATA_LOGS_DIR=logs

# ── Pipeline Behaviour ────────────────────────────────────────────────────────
# Default random seed for augmentation and splitting.  Change to get
# different (but still reproducible) results.
RANDOM_SEED=42

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Epic 3 API and inference gateway ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://slm_user:slm_secret@localhost:5432/email_slm
INFERENCE_URL=http://localhost:8000
INFERENCE_TIMEOUT_SECONDS=35
AUTO_CREATE_SCHEMA=true

# Set MODEL_PROVIDER to 'local' for loading the fine-tuned LoRA adapter directly from ./adapter
# Or 'http' when pointing to a remote inference server (vLLM / HuggingFace Endpoint).
MODEL_PROVIDER=local
MODEL_PROVIDER_CLASS=
MODEL_ENDPOINT=
MODEL_API_TOKEN=
MODEL_TIMEOUT_SECONDS=30
MODEL_NAME=qwen2.5-7b-lora
MODEL_VERSION=v0.1.0
MODEL_DIR=./adapter
SUMMARY_MAX_CHARS=320
